COMPOSE_PROJECT_NAME=joshbot
JOSHBOT_IMAGE=joshbot:v1.1.0

JOSHBOT_POSTGRES_DATA_DIR=/srv/joshbot/postgres
JOSHBOT_EXPORT_DIR=/srv/joshbot/exports
JOSHBOT_BACKUP_DIR=/mnt/nas/joshbot/backups

JOSHBOT_POSTGRES_ADMIN_PASSWORD_FILE=/srv/joshbot/secrets/postgres_admin_password
JOSHBOT_MIGRATOR_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_migrator_password
JOSHBOT_APP_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_app_password
JOSHBOT_REPORTER_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_reporter_password
JOSHBOT_OPERATOR_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_operator_password
JOSHBOT_BACKUP_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_backup_password
JOSHBOT_REPORT_TOKEN_FILE=/srv/joshbot/secrets/joshbot_report_token
JOSHBOT_OPERATOR_TOKEN_FILE=/srv/joshbot/secrets/joshbot_operator_token
JOSHBOT_WEB_BOT_AUTH_MODE=required
JOSHBOT_WEB_BOT_AUTH_ACTIVE_PRIVATE_KEY_FILE=/srv/joshbot/secrets/joshbot_web_bot_auth_active_private_key
# Optional during key rotation only:
# JOSHBOT_WEB_BOT_AUTH_TRANSITION_PRIVATE_KEY_FILE=/srv/joshbot/secrets/joshbot_web_bot_auth_transition_private_key

JOSHBOT_GITHUB_TOKEN_FILE=/srv/joshbot/secrets/joshbot_github_token
JOSHBOT_PUBLISH_GITHUB_OWNER=joshternet
JOSHBOT_PUBLISH_GITHUB_REPOSITORY=index-data
JOSHBOT_PUBLISH_GITHUB_BRANCH=main

JOSHBOT_LEASE_DURATION=5m
JOSHBOT_MIN_ORIGIN_INTERVAL=1m
JOSHBOT_POLL_INTERVAL=30s
JOSHBOT_JOB_TIMEOUT=2m
JOSHBOT_COMPLETION_GRACE=30s
JOSHBOT_RECHECK_INTERVAL=24h

# Logical heartbeat slots. Stable across restarts of the same service.
# Concurrent replicas need distinct IDs.
JOSHBOT_WORKER_SERVICE_INSTANCE_ID=worker
JOSHBOT_DISCOVERY_SERVICE_INSTANCE_ID=discovery

JOSHBOT_DISCOVERY_INTERVAL=168h
JOSHBOT_DISCOVERY_POLL_INTERVAL=30s
JOSHBOT_DISCOVERY_PAGE_TIMEOUT=30s

JOSHBOT_CRAWL_MAX_DEPTH=4
JOSHBOT_CRAWL_MAX_PAGES=32
JOSHBOT_CRAWL_MAX_PAGE_BYTES=1048576
JOSHBOT_CRAWL_REQUEST_DELAY=1s
JOSHBOT_CRAWL_REDIRECT_LIMIT=5

JOSHBOT_AUTOMATIC_CRAWL_ENABLED=false
JOSHBOT_AUTOMATIC_CRAWL_MAX_PENDING_PROBES=1000
JOSHBOT_AUTOMATIC_CRAWL_MAX_PROMOTIONS_PER_RUN=100
JOSHBOT_AUTOMATIC_CRAWL_EXCLUDED_HOSTS=
JOSHBOT_CRAWL_TELEMETRY_RETENTION=720h

JOSHBOT_REPORT_LISTEN_ADDRESS=0.0.0.0:8788
JOSHBOT_REPORT_NETWORK_NAME=joshbot-reporting
JOSHBOT_CONTROL_LISTEN_ADDRESS=0.0.0.0:8789
JOSHBOT_CONTROL_NETWORK_NAME=joshbot-control