COMPOSE_PROJECT_NAME=joshbot
JOSHBOT_IMAGE=joshbot:v1.0.0

JOSHBOT_POSTGRES_DATA_DIR=/srv/joshbot/postgres
JOSHBOT_EXPORT_DIR=/srv/joshbot/exports
JOSHBOT_BACKUP_DIR=/mnt/nas/joshbot/backups

JOSHBOT_POSTGRES_ADMIN_PASSWORD_FILE=/srv/joshbot/secrets/postgres_admin_password
JOSHBOT_MIGRATOR_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_migrator_password
JOSHBOT_APP_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_app_password
JOSHBOT_BACKUP_PASSWORD_FILE=/srv/joshbot/secrets/joshbot_backup_password

JOSHBOT_GITHUB_TOKEN_FILE=/srv/joshbot/secrets/joshbot_github_token
JOSHBOT_PUBLISH_GITHUB_OWNER=joshternet
JOSHBOT_PUBLISH_GITHUB_REPOSITORY=index-data
JOSHBOT_PUBLISH_GITHUB_BRANCH=main

JOSHBOT_LEASE_DURATION=5m
JOSHBOT_MIN_ORIGIN_INTERVAL=1m
JOSHBOT_POLL_INTERVAL=30s
JOSHBOT_JOB_TIMEOUT=2m
JOSHBOT_COMPLETION_GRACE=30s
JOSHBOT_RECHECK_INTERVAL=24h

JOSHBOT_DISCOVERY_INTERVAL=168h
JOSHBOT_DISCOVERY_POLL_INTERVAL=30s
JOSHBOT_DISCOVERY_PAGE_TIMEOUT=30s

JOSHBOT_CRAWL_MAX_DEPTH=4
JOSHBOT_CRAWL_MAX_PAGES=32
JOSHBOT_CRAWL_MAX_PAGE_BYTES=1048576
JOSHBOT_CRAWL_REQUEST_DELAY=1s
JOSHBOT_CRAWL_REDIRECT_LIMIT=5